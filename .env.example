# MemGuard-GM 环境变量示例
# 复制此文件为 .env 并填写实际值

# 存储路径
MEMGUARD_STORAGE_BASELINE_DIR=
MEMGUARD_STORAGE_MEMORY_DIR=
MEMGUARD_STORAGE_AUDIT_DIR=
MEMGUARD_STORAGE_BACKUP_DIR=

# 安全配置
MEMGUARD_SECURITY_ALLOW_UNLOCK=false

# 调度配置
MEMGUARD_SCHEDULER_CHECK_INTERVAL_SECONDS=14400

# API 配置
MEMGUARD_SERVER_HOST=0.0.0.0
MEMGUARD_SERVER_PORT=5050

# 日志配置
MEMGUARD_LOGGING_LEVEL=INFO
